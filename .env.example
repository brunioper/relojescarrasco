# ============================================================
# Relojes Carrasco — Variables de entorno
# ============================================================
# Copiar a .env.local para desarrollo local y completar valores.
# NUNCA commitear .env.local ni ningún archivo con secretos reales.
#
# Prefijo NEXT_PUBLIC_  -> expuesto al navegador (solo valores públicos).
# Sin prefijo           -> SOLO servidor. Jamás usar en componentes cliente.
# ============================================================

# ------------------------------------------------------------
# Supabase (REQUERIDAS — local y producción)
# ------------------------------------------------------------
# URL del proyecto Supabase. Segura para el navegador.
# Local: http://127.0.0.1:54321 | Producción: https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima (anon/publishable). Segura para el navegador: toda
# operación con esta clave pasa por Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service-role. SOLO SERVIDOR. Omite RLS por completo.
# - Nunca usar prefijo NEXT_PUBLIC_
# - Nunca commitear, loguear ni incluir en respuestas de error.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# Sitio (REQUERIDA en producción, opcional local)
# ------------------------------------------------------------
# URL canónica pública del sitio (sin barra final).
# Local: http://localhost:3000 | Producción: https://www.relojescarrasco.uy
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------
# Tipo de cambio automático (OPCIONAL)
# ------------------------------------------------------------
# API key del proveedor de cotizaciones (exchangerate.host / openexchangerates).
# Solo servidor. Si falta, el sistema sigue funcionando con tasas manuales.
EXCHANGE_RATE_API_KEY=

# ------------------------------------------------------------
# Seguridad (REQUERIDA en producción)
# ------------------------------------------------------------
# Secreto aleatorio (>= 32 caracteres) para firmar tokens de rate limiting
# del login. Generar con: openssl rand -base64 48
RATE_LIMIT_SECRET=

# ------------------------------------------------------------
# Importación de fotos desde Instagram (OPCIONAL)
# ------------------------------------------------------------
# App ID y App Secret de una app gratuita de Meta for Developers
# (developers.facebook.com/apps), usados solo para el oEmbed oficial
# de Instagram (lectura de la foto de portada de un post público).
# No requiere revisión de la app. Sin esto, la importación intenta
# scraping del HTML del post, que Instagram suele bloquear desde
# servidores — en ese caso queda la subida manual de fotos.
# Solo servidor.
META_APP_ID=
META_APP_SECRET=
